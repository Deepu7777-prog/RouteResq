# RouteResQ System Environment Configuration Example

# Backend API Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Google Maps API Configuration
# Replace YOUR_GOOGLE_MAPS_API_KEY_HERE with your Google Cloud Console API Key
# Make sure to enable Maps JavaScript API and Geocoding API in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
